# =============================================================
# eGranja Backend - Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env no repositorio.
# =============================================================

# ---- Backend / Servidor ----
PORT=8080
DATABASE_URL=postgres://egranja:senha-segura@localhost:5432/egranja?sslmode=disable
JWT_SECRET=chave-secreta-segura-trocar-em-producao
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=720h
BCRYPT_COST=12
GIN_MODE=debug

# ---- Storage (MinIO/S3) ----
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=egranja-media
STORAGE_USE_SSL=false

# ---- Firebase (push notifications) ----
FIREBASE_CREDENTIALS_FILE=./firebase-credentials.json

# ---- Gemini API (IA Preditiva) ----
GEMINI_API_KEY=sua-chave-gemini-aqui
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_CALLS_PER_USER_DAY=100

# ---- MQTT (IoT - Sensores) ----
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_USERNAME=egranja
MQTT_PASSWORD=senha-mqtt-segura
MQTT_TOPIC_PREFIX=egranja/

# ---- Previsao do Tempo ----
WEATHER_PROVIDER=open-meteo
WEATHER_FALLBACK_API_KEY=sua-chave-openweathermap-aqui
WEATHER_CRON_SCHEDULE=0 6,18 * * *

# ---- Mobile (referencia, nao usado pelo backend) ----
# API_BASE_URL=https://api.egranja.com.br/api/v1
# WS_BASE_URL=wss://api.egranja.com.br/api/v1/ws
