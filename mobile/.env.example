# eGranja Mobile - Variaveis de Ambiente
# Copie este arquivo para .env e ajuste os valores
#
# Uso: cp .env.example .env

# URL da API backend (sem barra final)
EXPO_PUBLIC_API_URL=http://10.0.170.0:8080/api/v1

# URL do WebSocket
EXPO_PUBLIC_WS_URL=ws://10.0.170.0:8080/api/v1/ws

# Ambiente (development | staging | production)
EXPO_PUBLIC_ENV=development
