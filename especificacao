    observacao TEXT,
    created_at TIMESTAMP NOT NULL DEFAULT now(),
    updated_at TIMESTAMP NOT NULL DEFAULT now()
);
CREATE INDEX idx_mortalidades_lote ON mortalidades(lote_id);
CREATE INDEX idx_mortalidades_lote_data ON mortalidades(lote_id, data DESC);

-- Tabela de Tipos de Racao  -- NOVO: normalizada
CREATE TABLE tipos_racao (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    nome VARCHAR(100) NOT NULL UNIQUE,  -- Pre-Inicial, Inicial, Crescimento, Finalizacao
    ordem INTEGER NOT NULL DEFAULT 0,
    created_at TIMESTAMP NOT NULL DEFAULT now()
);

-- Tabela de Recebimentos de Racao
CREATE TABLE feed_receipts (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    lote_id UUID REFERENCES lotes(id) ON DELETE CASCADE,
    tipo_racao_id UUID REFERENCES tipos_racao(id),  -- NOVO: FK normalizada
    quantidade_kg NUMERIC(12,3) NOT NULL,
    data_recebimento DATE NOT NULL,
    fornecedor VARCHAR(200),
    origem VARCHAR(30) NOT NULL DEFAULT 'compra' CHECK (origem IN ('compra', 'remanescente_anterior', 'sobra_final')),
    created_at TIMESTAMP NOT NULL DEFAULT now(),
    updated_at TIMESTAMP NOT NULL DEFAULT now()
);
CREATE INDEX idx_feed_receipts_lote ON feed_receipts(lote_id);

-- Tabela de Consumo de Racao
CREATE TABLE feed_consumptions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    lote_id UUID NOT NULL REFERENCES lotes(id) ON DELETE CASCADE,
    data DATE NOT NULL,
    quantidade_kg NUMERIC(12,3) NOT NULL CHECK (quantidade_kg > 0),
    created_at TIMESTAMP NOT NULL DEFAULT now(),
    updated_at TIMESTAMP NOT NULL DEFAULT now()
);
CREATE INDEX idx_feed_consumptions_lote ON feed_consumptions(lote_id);

-- Tabela de Destinatarios do WhatsApp
CREATE TABLE whatsapp_recipients (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    lote_id UUID NOT NULL REFERENCES lotes(id) ON DELETE CASCADE,
    numero VARCHAR(20) NOT NULL,
    nome VARCHAR(200),
    created_at TIMESTAMP NOT NULL DEFAULT now(),
    updated_at TIMESTAMP NOT NULL DEFAULT now(),
    UNIQUE(lote_id, numero)
);

-- Tabela de Historico de Envios via WhatsApp
CREATE TABLE whatsapp_send_histories (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    whatsapp_recipient_id UUID NOT NULL REFERENCES whatsapp_recipients(id),
    pesagem_id UUID REFERENCES pesagens(id) ON DELETE SET NULL,
    mortalidade_id UUID REFERENCES mortalidades(id) ON DELETE SET NULL,
    mensagem TEXT NOT NULL,
    status VARCHAR(20) NOT NULL CHECK (status IN ('enviado', 'falha')),
    tipo_envio VARCHAR(20) NOT NULL CHECK (tipo_envio IN ('pesagem', 'mortalidade')),
    erro TEXT,
    created_at TIMESTAMP NOT NULL DEFAULT now(),
    CHECK (
        (pesagem_id IS NOT NULL AND mortalidade_id IS NULL AND tipo_envio = 'pesagem') OR
        (pesagem_id IS NULL AND mortalidade_id IS NOT NULL AND tipo_envio = 'mortalidade')
    )  -- NOVO: constraint garante consistencia entre tipo_envio e FK
);
CREATE INDEX idx_wsh_recipient ON whatsapp_send_histories(whatsapp_recipient_id);
```

#### **6.3. Calculos de Desempenho**

  * **Ganho de Peso Medio por Ave (kg):** `(peso_medio_atual_g - peso_inicial_g) / 1000`.
      * Usa o `peso_inicial_g` configurado no lote (padrao 40g), em vez de valor fixo. *(MELHORIA)*
  * **Aves Vivas:** `quantidade_original - SUM(mortalidades.quantidade)`. *(NOVO)*
  * **Percentual de Mortalidade:** `(total_mortes / quantidade_original) * 100`. *(NOVO)*
  * **Consumo Real de Racao por Ave (kg):** `consumo_liquido_kg / aves_vivas`.
      * `consumo_liquido_kg` = SUM(feed_receipts onde origem != 'sobra_final') - SUM(feed_receipts onde origem = 'sobra_final'). *(MELHORIA: formula mais precisa)*
  * **Indice de Conversao Alimentar (ICA):** `consumo_medio_por_ave_kg / ganho_peso_medio_kg`.
  * **Indice de Eficiencia Alimentar (IEA):** `ganho_peso_medio_kg / consumo_medio_por_ave_kg`.
  * **Ganho de Peso Diario (GPD):** `peso_medio_atual_g / dias_de_alojamento`. *(NOVO)*
  * **Indice de Eficiencia Produtiva (IEP):** `((100 - % mortalidade) * peso_medio_kg * 100) / (idade_dias * ICA)`. *(NOVO)*

#### **6.4. Endpoints da API REST (Prefixo: `/api/v1`)**

**Autenticacao:**
  * `POST /auth/login` - Autentica e retorna access_token + refresh_token.
  * `POST /auth/refresh` - Renova o access_token usando o refresh_token. *(NOVO)*

**Lotes:**
  * `GET /lotes` - Lista lotes do usuario autenticado. Query params: `status` (ativo/finalizado), `page`, `per_page`.
  * `POST /lotes` - Cria um novo lote.
  * `GET /lotes/{id}` - Retorna detalhes de um lote com indicadores calculados.
  * `PATCH /lotes/{id}/finalizar` - Finaliza um lote. *(NOVO)*

**Pesagens:**
  * `GET /lotes/{lote_id}/pesagens` - Lista pesagens. Query params: `page`, `per_page`.
  * `POST /lotes/{lote_id}/pesagens` - Cria pesagem com items (nested).
  * `GET /lotes/{lote_id}/pesagens/{id}` - Detalhes de uma pesagem com items. *(NOVO)*

**Mortalidade:**
  * `GET /lotes/{lote_id}/mortalidades` - Lista mortalidades. Query params: `page`, `per_page`, `data_inicio`, `data_fim`.
  * `POST /lotes/{lote_id}/mortalidades` - Cria registro de mortalidade.

**Racao:**
  * `GET /lotes/{lote_id}/feed_receipts` - Lista recebimentos.
  * `POST /lotes/{lote_id}/feed_receipts` - Registra recebimento.
  * `GET /lotes/{lote_id}/feed_consumptions` - Lista consumos. *(NOVO)*
  * `POST /lotes/{lote_id}/feed_consumptions` - Registra consumo.
  * `GET /lotes/{lote_id}/racao/saldo` - Retorna saldo atual de racao. *(NOVO)*

**Indicadores:**
  * `GET /lotes/{lote_id}/indicadores` - Retorna ICA, IEA, GPD, IEP, mortalidade %, aves vivas. *(MELHORIA: endpoint unificado)*

**WhatsApp:**
  * `GET /lotes/{lote_id}/whatsapp_recipients` - Lista destinatarios.
  * `POST /lotes/{lote_id}/whatsapp_recipients` - Adiciona destinatario.
  * `DELETE /lotes/{lote_id}/whatsapp_recipients/{id}` - Remove destinatario. *(NOVO)*
  * `POST /lotes/{lote_id}/pesagens/{pesagem_id}/enviar_whatsapp` - Registra envio de pesagem.
  * `POST /lotes/{lote_id}/mortalidades/{mortalidade_id}/enviar_whatsapp` - Registra envio de mortalidade.

**Sincronizacao:** *(NOVO)*
  * `POST /sync` - Recebe array de operacoes pendentes do offline e retorna resultados consolidados.

**Auxiliares:** *(NOVO)*
  * `GET /galpaos` - Lista galpoes disponiveis.
  * `GET /tipos_racao` - Lista tipos de racao.
  * `GET /health` - Health check do servidor.

